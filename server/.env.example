# ============================================================
# 后端配置模板：仅提供本地开发占位示例值。
# 真实敏感值必须由开发者自行填写；本模板不得包含真实凭据。
# 必填项缺失时，服务与 ./scripts/devctl.sh 会显式失败。
# ============================================================

# --- 必填 ---
# 后端监听地址与端口（端口冲突时 devctl 会明确报错）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 日志与运行状态目录（相对 server/ 工作目录）
# 运行日志写入 server/logs/（backend.log / celery.log / frontend.log）
# 运行状态写入 server/.runtime/（PID 文件、Celery 队列、结果库）
LOG_DIR=logs
RUNTIME_DIR=.runtime

# Celery 本地链路：文件系统 broker（结果存储已迁移至 PostgreSQL，见 Task 8）
# 开发者如需接入真实 broker，请替换为已批准的基础设施连接串
CELERY_BROKER_URL=filesystem://
CELERY_BROKER_DIR=.runtime/celery-queue

# PostgreSQL（pgvector）持久化：docker/docker-compose.dev.yml 提供本地实例
DATABASE_URL=postgresql+psycopg://ai_flow:ai_flow@postgres:5432/ai_flow
POSTGRES_DB=ai_flow
POSTGRES_USER=ai_flow
POSTGRES_PASSWORD=ai_flow

# --- 可选 ---
DEBUG=true
FRONTEND_PORT=5173

# --- 认证（邮箱验证码与密码登录，见 specs/003-email-password-auth） ---
# 会话与刷新资格 TTL；本地开发可把 access TTL 设为较短值便于验证刷新链路
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=14
# 验证码有效期与双重发送限流（最小间隔 + 滚动窗口内最大次数）
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MIN_INTERVAL_SECONDS=60
AUTH_CODE_WINDOW_SECONDS=900
AUTH_CODE_WINDOW_LIMIT=5
# Cookie 会话：本地 http 开发时 secure 必须为 false
AUTH_COOKIE_SECURE=false
# CORS allow_credentials 使用的来源
FRONTEND_ORIGIN=http://127.0.0.1:5173

# SMTP：发送验证码邮件；配置缺失时发送接口显式失败，不静默兜底
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
