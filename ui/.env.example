# ============================================================
# 前端配置模板：仅提供本地开发占位示例值。
# 如果后端端口调整，必须同步修改 VITE_API_BASE_URL。
# ============================================================

# --- 必填 ---
# 前端运行日志由 devctl 写入 server/logs/frontend.log
# 认证请求统一通过 credentials: "include" 自动携带 Cookie（见 ui/src/shared/lib/http.ts），
# 该值必须与后端 FRONTEND_ORIGIN 匹配，否则 Cookie 不会被浏览器附带。
VITE_API_BASE_URL=http://127.0.0.1:8000
